# ==============================================================================
# Dream Studio 2.0 — 고가용성 멀티 프로바이더 AI 설정 예시
# 여러 개를 함께 설정하면 429(한도 초과) / 503(혼잡) 시 자동으로 다음 AI로 전환됩니다.
# 같은 프로바이더에 쉼표(,)로 여러 키를 넣으면 라운드로빈으로 부하를 분산합니다.
# ==============================================================================

# 우선 사용할 프로바이더 (github | gemini | openrouter | groq | openai | anthropic)
# AI_PROVIDER=github

# 동시 LLM 호출 상한 (많은 학생이 동시에 눌러도 대기열로 안정 처리)
AI_MAX_CONCURRENT=3

# 1) GitHub Models (무료 티어, Fine-grained PAT에 models:read 권한 필요)
# GITHUB_TOKEN=github_pat_...
# GITHUB_TOKENS=github_pat_1,github_pat_2
# GITHUB_MODEL=openai/gpt-4.1-mini

# 2) Google Gemini (여러 키 쉼표 구분 가능, 3-flash → 3.1-flash-lite 자동 폴백)
# GEMINI_API_KEY=...
# GEMINI_API_KEYS=key1,key2
# AI_MODEL=gemini-3-flash-preview

# 3) OpenRouter 무료 코딩 모델 (https://openrouter.ai)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=qwen/qwen3-coder:free

# 4) Groq 초고속 무료 티어 (https://console.groq.com)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# 5) OpenAI 또는 로컬 무제한 Ollama (예: OPENAI_BASE_URL=http://127.0.0.1:11434/v1)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini

# 6) Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...
